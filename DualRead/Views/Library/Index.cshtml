@model LibraryViewModel
@{
    ViewData["Title"] = "Library";
    var currentLang = (ViewBag.Language as string) ?? "en";
}

<div class="library-page">
    <div class="lib-head">
        <div class="lib-head-top">
            <h1 class="library-main-title">
                <span data-i18n="lib.title">Library</span>
                <span class="library-title-sep">/</span>
                <span class="library-sub-title" data-i18n="lib.allBooks" data-i18n-params='{"n":@Model.TotalCount}'>All books (@Model.TotalCount)</span>
            </h1>
            <a id="btn-upload-header" class="lib-btn lib-btn-primary lib-head-upload" asp-controller="Home" asp-action="Index">
                <span data-i18n="lib.upload">+ Upload</span>
            </a>
        </div>
        <div class="lib-head-tools">
            <div class="lang-segmented-control" role="group" data-i18n-aria="lib.langAria" aria-label="Language">
                <button type="button" class="lang-seg-btn @(currentLang == "en" ? "active" : "")" data-lang="en">EN</button>
                <button type="button" class="lang-seg-btn @(currentLang == "vi" ? "active" : "")" data-lang="vi">VI</button>
            </div>
            <button type="button" id="btn-recovery-key" class="lib-btn lib-btn-key" data-key-code="@ViewBag.RecoveryKeyCode" data-i18n-title="lib.keyTitle" title="Click to copy your Recovery Key">
                <span class="recovery-badge-label" data-i18n="lib.keyLabel">Recovery Key:</span>
                <span id="recovery-key-text">@ViewBag.RecoveryKeyCode</span>
            </button>
            <button type="button" id="btn-vocabulary" class="lib-btn lib-btn-secondary">
                <span data-i18n="lib.vocab">Vocabulary</span>
                <span id="vocab-count-badge" class="lib-tab-count">0</span>
            </button>
        </div>
    </div>

    @if (TempData["UploadSuccessCount"] is int successCount && successCount > 0)
    {
        <div class="alert alert-success">
            <strong>Uploaded @successCount file(s) successfully:</strong>
            @if (TempData["UploadSuccessFiles"] is string successFilesRaw && !string.IsNullOrEmpty(successFilesRaw))
            {
                <ul class="mb-0">
                    @foreach (var line in successFilesRaw.Split('|', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <li>@line</li>
                    }
                </ul>
            }
        </div>
    }

    @if (TempData["UploadErrors"] is string uploadErrorsRaw && !string.IsNullOrEmpty(uploadErrorsRaw))
    {
        <div class="alert alert-danger">
            <strong>Some files failed to upload:</strong>
            <ul class="mb-0">
                @foreach (var line in uploadErrorsRaw.Split('|', StringSplitOptions.RemoveEmptyEntries))
                {
                    <li>@line</li>
                }
            </ul>
        </div>
    }

    <div class="library-nav-tabs" role="tablist">
        <button type="button" class="lib-tab-btn active" data-tab="books" role="tab">
            <span data-i18n="lib.tabBooks">All books</span>
            <span class="lib-tab-count">@Model.TotalCount</span>
        </button>
        <button type="button" class="lib-tab-btn" data-tab="albums" role="tab">
            <span data-i18n="lib.tabAlbums">Albums</span>
            <span id="albums-count-badge" class="lib-tab-count">0</span>
        </button>
    </div>

    <section id="panel-books" class="library-panel">
        @if (Model.Books.Count == 0)
        {
            <div class="library-empty-box">
                <p class="text-secondary" data-i18n="lib.empty">No books yet. Upload your first EPUB, PDF or DOCX to get started.</p>
            </div>
        }
        else
        {
            <div class="library-toolbar">
                <div class="library-search-box">
                    <svg class="library-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="search" id="library-search-input" class="library-search-input" autocomplete="off" data-i18n-placeholder="lib.searchPlaceholder" placeholder="Search title or author..." />
                    <button type="button" id="library-search-clear" class="library-search-clear" data-i18n-aria="lib.searchClear" aria-label="Clear search" hidden>&times;</button>
                </div>
                <div class="library-toolbar-actions">
                    <select id="library-sort-select" class="library-sort-select" data-i18n-aria="lib.sortAria" aria-label="Sort books">
                        <option value="newest" data-i18n="lib.sortNewest">Newest</option>
                        <option value="oldest" data-i18n="lib.sortOldest">Oldest</option>
                        <option value="title" data-i18n="lib.sortTitle">Title A-Z</option>
                        <option value="titleDesc" data-i18n="lib.sortTitleDesc">Title Z-A</option>
                        <option value="author" data-i18n="lib.sortAuthor">Author A-Z</option>
                    </select>
                    <div class="library-view-toggle" role="group" data-i18n-aria="lib.viewAria" aria-label="View mode">
                        <button type="button" class="library-view-btn active" data-view="grid" data-i18n-title="lib.viewGrid" title="Grid view" aria-pressed="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect></svg>
                        </button>
                        <button type="button" class="library-view-btn" data-view="list" data-i18n-title="lib.viewList" title="List view" aria-pressed="false">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                        </button>
                    </div>
                </div>
            </div>

            <div id="library-sections" class="library-sections-container">
                @foreach (var groupType in new[] { BookType.Epub, BookType.Pdf, BookType.Docx })
                {
                    var groupBooks = Model.Books.Where(b => b.Type == groupType).ToList();
                    if (groupBooks.Count == 0)
                    {
                        continue;
                    }

                    var formatCode = groupType.ToString().ToLowerInvariant();

                    <div class="library-format-section" data-format="@formatCode">
                        <div class="library-format-header">
                            <div class="library-format-title-group">
                                <h2 class="library-format-heading" data-i18n="@("lib.group." + formatCode)">@groupType.ToString().ToUpperInvariant() books</h2>
                                <span class="library-format-count">(@groupBooks.Count)</span>
                            </div>
                            <div class="library-format-line"></div>
                        </div>
                        <div class="bk-grid">
                            @foreach (var book in groupBooks)
                            {
                                var started = Model.StartedBookIds.Contains(book.Id);

                                <article class="bk-card" data-book-id="@book.Id" data-title="@book.Title" data-author="@(book.Author ?? "")" data-uploaded="@book.UploadedAtUtc.ToString("o")">
                                    <div class="bk-cover">
                                        @if (!string.IsNullOrEmpty(book.CoverImagePath))
                                        {
                                            <img src="@book.CoverImagePath" alt="@book.Title" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="bk-placeholder"></div>
                                        }
                                    </div>
                                    <span class="bk-badge format-badge format-badge-@formatCode">@book.Type</span>
                                    <div class="bk-info">
                                        <h3 class="bk-title" title="@book.Title">@book.Title</h3>
                                        <div class="bk-author">@(string.IsNullOrEmpty(book.Author) ? "\u00A0" : book.Author)</div>
                                        <span class="bk-status @(started ? "is-reading" : "")" data-i18n="@(started ? "lib.statusReading" : "lib.statusUnread")">@(started ? "Reading" : "Not started")</span>
                                    </div>
                                    <div class="bk-actions">
                                        <a class="bk-act bk-act-primary book-read-btn" asp-controller="Reader" asp-action="Index" asp-route-id="@book.Id" data-i18n="lib.read">Read</a>
                                        <button type="button" class="bk-act book-albums-btn" data-book-id="@book.Id" data-i18n="lib.addAlbum" data-i18n-title="lib.addAlbumTitle" title="Add to album">Album</button>
                                        <button type="button" class="bk-act book-rename-btn"
                                                data-book-id="@book.Id"
                                                data-book-title="@book.Title"
                                                data-book-author="@(book.Author ?? "")"
                                                data-i18n="lib.rename"
                                                data-i18n-title="lib.renameTitle"
                                                title="Rename book">
                                            Rename
                                        </button>
                                        <form asp-controller="Library" asp-action="Delete" method="post" class="bk-delete-form book-delete-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@book.Id" />
                                            <button type="submit" class="bk-act bk-act-danger book-delete-btn" data-i18n="lib.delete" data-i18n-title="lib.deleteTitle" title="Delete book">Delete</button>
                                        </form>
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                }
            </div>

            <div id="library-no-results" class="library-empty-box" hidden>
                <p class="text-secondary" data-i18n="lib.noResults">No matching books.</p>
            </div>
        }
    </section>

    <section id="panel-albums" class="library-panel" hidden>
        <div class="albums-toolbar">
            <button type="button" id="btn-create-album" class="lib-btn lib-btn-primary">
                <span data-i18n="album.create">+ New album</span>
            </button>
        </div>
        <div id="albums-banner-stack" class="alb-stack"></div>
        <div id="albums-empty-state" class="albums-empty-state" hidden>
            <div class="albums-empty-icon" aria-hidden="true">&#128218;</div>
            <h3 class="albums-empty-title" data-i18n="album.emptyTitle">No albums yet</h3>
            <p class="albums-empty-desc" data-i18n="album.emptyText">Create an album to group your books.</p>
        </div>
    </section>

    <div id="book-rename-modal-backdrop" class="lib-modal-backdrop" style="display:none;">
        <div class="lib-modal-card" role="dialog" aria-modal="true" aria-labelledby="book-rename-modal-title">
            <div class="lib-modal-header">
                <h3 id="book-rename-modal-title" class="lib-modal-title" data-i18n="rename.title">Rename book</h3>
                <button type="button" class="lib-modal-close-btn" data-close-modal="book-rename-modal-backdrop" data-i18n-aria="modal.close" aria-label="Close">&times;</button>
            </div>
            <form id="book-rename-form">
                @Html.AntiForgeryToken()
                <input type="hidden" id="rename-book-id" value="" />
                <div class="lib-modal-body">
                    <div class="lib-form-group">
                        <label for="rename-book-title-input" class="lib-form-label" data-i18n="rename.titleLabel">Title *</label>
                        <input type="text" id="rename-book-title-input" class="lib-form-input" required maxlength="450" autocomplete="off" />
                    </div>
                    <div class="lib-form-group">
                        <label for="rename-book-author-input" class="lib-form-label" data-i18n="rename.authorLabel">Author (optional)</label>
                        <input type="text" id="rename-book-author-input" class="lib-form-input" maxlength="450" autocomplete="off" />
                    </div>
                </div>
                <div class="lib-modal-footer">
                    <button type="button" class="lib-btn lib-btn-secondary" data-close-modal="book-rename-modal-backdrop" data-i18n="modal.cancel">Cancel</button>
                    <button type="submit" id="rename-book-save-btn" class="lib-btn lib-btn-primary" data-i18n="modal.save">Save</button>
                </div>
            </form>
        </div>
    </div>

    <div id="vocabulary-modal-backdrop" class="lib-modal-backdrop" style="display:none;">
        <div class="lib-modal-card lib-modal-card-lg" role="dialog" aria-modal="true" aria-labelledby="vocabulary-modal-title">
            <div class="lib-modal-header">
                <h3 id="vocabulary-modal-title" class="lib-modal-title" data-i18n="vocab.title">Vocabulary</h3>
                <button type="button" class="lib-modal-close-btn" data-close-modal="vocabulary-modal-backdrop" data-i18n-aria="modal.close" aria-label="Close">&times;</button>
            </div>
            <div class="lib-modal-body">
                <div class="lib-form-group">
                    <label for="vocabulary-book-filter" class="lib-form-label" data-i18n="vocab.filter">Filter by book</label>
                    <select id="vocabulary-book-filter" class="form-select form-select-sm settings-input">
                        <option value="" data-i18n="vocab.all">All books</option>
                    </select>
                </div>
                <ul id="vocabulary-list" class="sidebar-list"></ul>
                <p id="vocabulary-empty-hint" class="sidebar-list-empty" hidden></p>
            </div>
        </div>
    </div>

    <div id="album-form-modal-backdrop" class="lib-modal-backdrop" style="display:none;">
        <div class="lib-modal-card" role="dialog" aria-modal="true" aria-labelledby="album-form-modal-title">
            <div class="lib-modal-header">
                <h3 id="album-form-modal-title" class="lib-modal-title" data-i18n="album.formCreateTitle">New album</h3>
                <button type="button" class="lib-modal-close-btn" data-close-modal="album-form-modal-backdrop" data-i18n-aria="modal.close" aria-label="Close">&times;</button>
            </div>
            <form id="album-form">
                <input type="hidden" id="album-form-id" value="" />
                <div class="lib-modal-body">
                    <div class="lib-form-group">
                        <label for="album-form-name" class="lib-form-label" data-i18n="album.nameLabel">Name *</label>
                        <input type="text" id="album-form-name" class="lib-form-input" required maxlength="200" autocomplete="off" />
                    </div>
                    <div class="lib-form-group">
                        <label for="album-form-description" class="lib-form-label" data-i18n="album.descLabel">Description (optional)</label>
                        <textarea id="album-form-description" class="lib-form-textarea" rows="3" maxlength="500"></textarea>
                    </div>
                    <p id="album-form-error" class="album-form-error" hidden></p>
                </div>
                <div class="lib-modal-footer">
                    <button type="button" class="lib-btn lib-btn-secondary" data-close-modal="album-form-modal-backdrop" data-i18n="modal.cancel">Cancel</button>
                    <button type="submit" id="album-form-save-btn" class="lib-btn lib-btn-primary" data-i18n="modal.save">Save</button>
                </div>
            </form>
        </div>
    </div>

    <div id="book-albums-modal-backdrop" class="lib-modal-backdrop" style="display:none;">
        <div class="lib-modal-card" role="dialog" aria-modal="true" aria-labelledby="book-albums-modal-title">
            <div class="lib-modal-header">
                <h3 id="book-albums-modal-title" class="lib-modal-title" data-i18n="album.pickerTitle">Add to albums</h3>
                <button type="button" class="lib-modal-close-btn" data-close-modal="book-albums-modal-backdrop" data-i18n-aria="modal.close" aria-label="Close">&times;</button>
            </div>
            <div class="lib-modal-body">
                <input type="hidden" id="book-albums-book-id" value="" />
                <p id="book-albums-none" class="sidebar-list-empty" data-i18n="album.pickerNone" hidden>You have no albums yet. Create one below.</p>
                <div id="book-albums-checkbox-list" class="lib-checkbox-list"></div>
                <div class="lib-checkbox-quick-create">
                    <input type="text" id="quick-album-name" class="lib-form-input" maxlength="200" autocomplete="off" data-i18n-placeholder="album.quickPlaceholder" placeholder="New album name..." />
                    <button type="button" id="quick-album-create-btn" class="lib-btn lib-btn-secondary" data-i18n="album.quickCreate">Create</button>
                </div>
            </div>
            <div class="lib-modal-footer">
                <button type="button" class="lib-btn lib-btn-secondary" data-close-modal="book-albums-modal-backdrop" data-i18n="modal.cancel">Cancel</button>
                <button type="button" id="book-albums-save-btn" class="lib-btn lib-btn-primary" data-i18n="modal.save">Save</button>
            </div>
        </div>
    </div>

    <div id="album-add-books-modal-backdrop" class="lib-modal-backdrop" style="display:none;">
        <div class="lib-modal-card" role="dialog" aria-modal="true" aria-labelledby="album-add-books-modal-title">
            <div class="lib-modal-header">
                <h3 id="album-add-books-modal-title" class="lib-modal-title" data-i18n="album.addBooksTitle">Add books to album</h3>
                <button type="button" class="lib-modal-close-btn" data-close-modal="album-add-books-modal-backdrop" data-i18n-aria="modal.close" aria-label="Close">&times;</button>
            </div>
            <div class="lib-modal-body">
                <input type="hidden" id="album-add-books-album-id" value="" />
                <p id="album-add-books-none" class="sidebar-list-empty" data-i18n="album.addBooksNone" hidden>All your books are already in this album.</p>
                <div id="album-add-books-list" class="lib-checkbox-list"></div>
            </div>
            <div class="lib-modal-footer">
                <button type="button" class="lib-btn lib-btn-secondary" data-close-modal="album-add-books-modal-backdrop" data-i18n="modal.cancel">Cancel</button>
                <button type="button" id="album-add-books-save-btn" class="lib-btn lib-btn-primary" data-i18n="album.addBooksConfirm">Add</button>
            </div>
        </div>
    </div>
</div>

<script id="app-settings" type="application/json">{"language":"@currentLang"}</script>

@section Scripts {
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    <script src="~/js/library.js" asp-append-version="true"></script>
}
